rtruncnorm <- function(n, a, b, mu, s) {
F.a <- pnorm(a, mean = mu, sd = s)
F.b <- pnorm(b, mean = mu, sd = s)
u <- runif(n, min = F.a, max = F.b)
return(qnorm(u, mean = mu, sd = s))
}
