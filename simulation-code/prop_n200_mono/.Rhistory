rows <- nrow(cad_call_19_23)
columns <- ncol(cad_call_19_23)
cat("**Rows:**", formatC(rows, format="d", big.mark=","), "\n\n")
cat("**Columns:**", columns, "\n")
# Calculate missing counts and ratios
missing_counts <- sapply(cad_call_23, function(x) {
if (is.vector(x) || is.factor(x)) {
sum(is.na(x))
} else {
sum(is.na(as.character(x)))
}
})
total_rows <- nrow(cad_call_23)
missing_ratios <- round(missing_counts / total_rows * 100, 2)
# Create a dataframe to store the results
missing_data <- data.frame(
Column = names(cad_call_23),
MissingCount = missing_counts,
MissingRatio = missing_ratios
)
row.names(missing_data) <- 1:nrow(missing_data)
# Create a markdown table
knitr::kable(missing_data,
col.names = c("Column Name", "Missing Count", "Missing Ratio (%)"),
row.names = FALSE,
format = "markdown")
variable_80 = missing_data %>% filter(MissingRatio < 20)
variable_80
var_include = variable_80$Column
df_80 = cad_call_23[, ..var_include]
variable_0 = missing_data %>% filter(MissingRatio == 100)
variable_0
var_include = variable_0$Column
df_not0 = cad_call_23[, -..var_include]
str(df_not0)
