filter(year(calltime) >= 2023) %>%
mutate(across(where(is.character), ~ifelse(str_detect(trimws(.x), "^$") | .x == "NULL", NA, .x)))
for (i in 1:ncol(cad_call_23)) {
var = cad_call_23[, ..i][[1]]
ind = str_detect(var, "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}$")
ind = ind[which(!is.na(ind))]
ind = prod(ind)
if(ind == 1){
var = ymd_hms(var)
}
cad_call_23[, i] = var
}
