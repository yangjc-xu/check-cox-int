}
f = function(x){
return(ifelse(x < 1, (exp(x)-1)/x, (exp(1)-1)/x))
}
x = seq(-2,2,1000)
plot(x, f(x), ty = "l")
plot(x, f(x), type = "l")
plot(x, y = f(x), type = "l")
f(x)
x = seq(-2,2,1000)
x = seq(-2,2,0.001)
plot(x, y = f(x), type = "l")
x = seq(-2,3,0.001)
plot(x, y = f(x), type = "l")
x = seq(-3,3,0.001)
plot(x, y = f(x), type = "l")
12.5/9*12
7+3*6
4200*12
