library(data.table)
library(tidyverse)
## Use the following code to set work directory
## Replace . with the path to the folder code_NE
#setwd("./code_NE")
setwd("/Users/yangjianchenxu/Dropbox/Yang/UNC/XBB Data")
load("tab_all_0221.RData")
tau = as.numeric(difftime(as.Date("20240221", "%Y%m%d"), as.Date("20201210", "%Y%m%d"), units="days"), units="days")+1
cutoff = as.numeric(difftime(as.Date("20230911", "%Y%m%d"), as.Date("20201210", "%Y%m%d"), units="days"), units="days")
## XBB
tab_all$age = as.character(tab_all$age)
tab_all$age[which(tab_all$age %in% c("<5", "5-12"))] = "0-11"
tab_all$age[which(tab_all$age %in% c("12-17", "18-34", "35-49", "50-64"))] = "12-64"
tab_all$vac_ind = ifelse(tab_all$RecVac < 270, "yes", "no")
tab_all$inf_ind = ifelse(tab_all$RecInf_new < 270, "yes", "no")
tab_all$xbb_ind = ifelse(tab_all$xbb_vacdate < tau, "yes", "no")
tab_all_uni = tab_all[!duplicated(tab_all$cluster_id, fromLast = F),]
length(unique(tab_all$cluster_id))
table(tab_all_uni$xbb_trade_name)
sum(tab_all$infection.time >= cutoff & tab_all$infection.time < tab_all$censor.time)
sum(tab_all_uni$death.time < tau)
sum(tab_all_uni$hosp.time < tau)
df_all = data.frame(attri = "All", value = "All", person = length(unique(tab_all$cluster_id)), person_perc = 100,
MOD = sum(tab_all_uni$xbb_trade_name == "MOD"),
MOD_perc = sum(tab_all_uni$xbb_trade_name == "MOD")/length(unique(tab_all$cluster_id))*100,
PFR = sum(tab_all_uni$xbb_trade_name == "PFR"),
PFR_perc = sum(tab_all_uni$xbb_trade_name == "PFR")/length(unique(tab_all$cluster_id))*100,
NVX = sum(tab_all_uni$xbb_trade_name == "NVX"),
NVX_perc = sum(tab_all_uni$xbb_trade_name == "NVX")/length(unique(tab_all$cluster_id))*100,
NON = sum(tab_all_uni$xbb_trade_name == "NON"),
NON_perc = sum(tab_all_uni$xbb_trade_name == "NON")/length(unique(tab_all$cluster_id))*100,
infection = sum(tab_all$infection.time >= cutoff & tab_all$infection.time < tab_all$censor.time),
inf_perc = sum(tab_all$infection.time >= cutoff & tab_all$infection.time < tab_all$censor.time)/length(unique(tab_all$cluster_id))*100,
hosp = sum(tab_all$hosp.time >= cutoff & tab_all$hosp.time < tab_all$censor.time),
hosp_perc = sum(tab_all$hosp.time >= cutoff & tab_all$hosp.time < tab_all$censor.time)/length(unique(tab_all$cluster_id))*100,
death = sum(tab_all_uni$death.time >= cutoff & tab_all_uni$death.time < tab_all_uni$censor.time),
death_perc = sum(tab_all_uni$death.time >= cutoff & tab_all_uni$death.time < tab_all_uni$censor.time)/length(unique(tab_all$cluster_id))*100)
## Vaccine
d1 = tab_all %>%
group_by(xbb_ind) %>%
summarise(infection = sum(infection.time >= cutoff & infection.time < censor.time),
infection_after_booster = sum(infection.time >= cutoff & infection.time < censor.time & infection.time > xbb_vacdate, na.rm = T),
hosp = sum(hosp.time >= cutoff & hosp.time < censor.time),
hosp_after_booster = sum(hosp.time >= cutoff & hosp.time < censor.time & hosp.time > xbb_vacdate, na.rm = T))
d2 = tab_all_uni %>%
group_by(xbb_ind) %>%
summarise(person = n(),
MOD = sum(xbb_vacdate<tau & xbb_trade_name == "MOD"),
PFR = sum(xbb_vacdate<tau & xbb_trade_name == "PFR"),
NVX = sum(xbb_vacdate<tau & xbb_trade_name == "NVX"),
NON = sum(xbb_trade_name == "NON"),
death = sum(death.time >= cutoff & death.time < censor.time))
d = merge(d1, d2, by = "xbb_ind") %>%
mutate(person_perc = person / sum(person) * 100,
MOD_perc = MOD / person * 100,
PFR_perc = PFR / person * 100,
NVX_perc = NVX / person * 100,
NON_perc = NON / person * 100,
inf_perc = infection / person * 100,
hosp_perc = hosp / person * 100,
death_perc = death / person * 100,
attri = "xbb_ind")
d
