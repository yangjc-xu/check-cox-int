geom_line(aes(x = Time, y = W20, color = "Simulated", linewidth = "Simulated")) +
geom_line(aes(x = Time, y = W, color = "Observed", linewidth = "Observed")) +
labs(x = "Days of follow-up", y = "Pseudo-score process") +
scale_x_continuous(limits = c(900,9700), breaks = seq(900,9700,800), expand = expansion(0,0)) +
scale_y_continuous(limits = c(-1,2.5), breaks = c(seq(-1,2.5,0.5)), expand = expansion(0,0)) +
