}
p_prop_diabt_glucose = ggplot(data = df_prop_diabt_glucose_trans) +
theme_light() +
geom_line(aes(x = Time, y = W1, color = "Simulated", linewidth = "Simulated")) +
geom_line(aes(x = Time, y = W2, color = "Simulated", linewidth = "Simulated")) +
