df_cate[[cate_i]] = pmax(1, mat_keyword[,ind_i])
} else{
df_cate[[cate_i]] = pmax(1, rowSums(mat_keyword[,ind_i]))
}
}
View(df_cate)
cate = unique(keyword$`Proposed Lab Category`)
keyword_all = colnames(df[,c(9:103)])
df_cate = df[,c(7)]
mat_keyword = as.matrix(df[,c(9:103)])
for (i in 1:length(cate)) {
cate_i = cate[i]
keyword_i = unique(keyword$`Keyword (verbatim)`[which(keyword$`Proposed Lab Category` == cate_i)])
ind_i = match(keyword_i, keyword_all)
if(length(ind_i) <= 1){
df_cate[[cate_i]] = pmin(1, mat_keyword[,ind_i])
} else{
df_cate[[cate_i]] = pmin(1, rowSums(mat_keyword[,ind_i]))
}
}
View(df_cate)
tmp = rowSums(df_cate[,c(2:9)])
ind = which(tmp == 1)
df_cate_one = df_cate[ind,]
View(df_cate_one)
View(df_keyword_one)
save(df_cate, df_cate_one, df_keyword, df_keyword_one, file = "results.RData")
rm(list = ls())
